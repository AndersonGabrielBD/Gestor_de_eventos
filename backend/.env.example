# Copie para .env e preencha. NUNCA commite o .env.

AMBIENTE=dev

# Conexão do backend com o Postgres do Supabase (Settings > Database > Connection string).
# Use o driver asyncpg. Supabase local: postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# Supabase (Settings > API)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Se o projeto usa o segredo JWT legado (HS256), preencha. Se vazio, a API valida via JWKS
# em {SUPABASE_URL}/auth/v1/.well-known/jwks.json (chaves assimétricas).
SUPABASE_JWT_SECRET=

# Origem do frontend liberada no CORS
CORS_ORIGINS=["http://localhost:5173"]

# URL pública usada no QR Code dos certificados (aponta para a tela T17)
URL_PUBLICA_VALIDACAO=http://localhost:5173/validar

# Chaves para dados sensíveis (RNF-007). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAVE_CIFRAGEM_DADOS=
#   python -c "import secrets; print(secrets.token_hex(32))"
CHAVE_HMAC_DADOS=

# Senha dos usuários de teste criados por `python -m scripts.criar_usuarios_teste`
# (só no projeto de desenvolvimento). Vazio = o script gera uma e mostra no terminal.
SENHA_USUARIOS_TESTE=
